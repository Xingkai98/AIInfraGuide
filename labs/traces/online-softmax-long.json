     "sym": "m^{(j)}",
     "idx": "m^{1}",
     "num": "0.83"
    },
    "WSUM": {
     "sym": "\\sum_i \\exp(x^{(j)}_i - m^{(j)})\\cdot x^{(j)}_i",
