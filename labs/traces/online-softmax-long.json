   "writes": [
    "l"
   ],
   "state": {
    "l": 1.3570069605691475
   },
   "narration": "第一块没有历史，修正因子是 0（ℓ 旧值是 0），只加本块的 1 + 0.357 = 1.357。",
   "regions": {
    "CORR": "修正因子 e^(m_old - m_new) = 0，第一块时恒为 0"
   }
  },
  {
   "id": "a1",
   "title": "第 1 块：更新累加器 acc",
   "kind": "op",
   "op": "fma",
   "phase": "输出更新",
   "formula": {
    "sym": "\\mathrm{acc}^{(j)} = \\slot{AOLD}\\cdot \\region{CORR}{\\exp\\left(m^{(j-1)} - m^{(j)}\\right)} + \\sum_i \\exp\\left(x^{(j)}_i - m^{(j)}\\right)\\cdot x^{(j)}_i",
    "idx": "\\mathrm{acc}^{(\\slot{J})} = \\slot{AOLD}\\cdot \\region{CORR}{\\exp\\left(\\slot{MOLD} - \\slot{MNEW}\\right)} + \\slot{WSUM}",
    "num": "\\mathrm{acc}^{(\\slot{J})} = \\slot{AOLD}\\cdot \\region{CORR}{\\exp\\left(\\slot{MOLD} - \\slot{MNEW}\\right)} + \\slot{WSUM} = \\slot{ANEW}"
   },
   "bindings": {
    "J": {
     "sym": "j",
     "idx": "1",
     "num": "1"
    },
    "AOLD": {
     "sym": "\\mathrm{acc}^{(j-1)}",
