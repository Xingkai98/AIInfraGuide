     "sym": "j",
     "idx": "1",
     "num": "1"
    },
    "LO": {
     "sym": "(j-1)B_c",
     "idx": "0",
     "num": "0"
    },
    "HI": {
     "sym": "jB_c",
     "idx": "2",
     "num": "2"
    },
    "VALS": {
     "sym": "[\\cdot]",
