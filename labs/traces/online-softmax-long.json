  {
   "id": "l1",
   "title": "第 1 块：更新指数和 ℓ",
   "kind": "op",
   "op": "sum-exp",
   "phase": "统计量更新",
   "formula": {
    "sym": "\\ell^{(j)} = \\slot{LOLD}\\cdot \\region{CORR}{\\exp\\left(m^{(j-1)} - m^{(j)}\\right)} + \\sum_i \\exp\\left(x^{(j)}_i - m^{(j)}\\right)",
    "idx": "\\ell^{(\\slot{J})} = \\slot{LOLD}\\cdot \\region{CORR}{\\exp\\left(\\slot{MOLD} - \\slot{MNEW}\\right)} + \\slot{SUM}",
    "num": "\\ell^{(\\slot{J})} = \\slot{LOLD}\\cdot \\region{CORR}{\\exp\\left(\\slot{MOLD} - \\slot{MNEW}\\right)} + \\slot{SUM} = \\slot{LNEW}"
   },
   "bindings": {
    "J": {
     "sym": "j",
     "idx": "1",
     "num": "1"
    },
    "LOLD": {
     "sym": "\\ell^{(j-1)}",
     "idx": "\\ell^{0}",
     "num": "0"
    },
    "MOLD": {
     "sym": "m^{(j-1)}",
     "idx": "m^{0}",
     "num": "-\\infty"
    },
    "MNEW": {
     "sym": "m^{(j)}",
     "idx": "m^{1}",
     "num": "0.83"
    },
    "SUM": {
     "sym": "\\sum_i \\exp(x^{(j)}_i - m^{(j)})",
     "idx": "\\sum_i \\exp(x^{1}_i - m^{1})",
     "num": "1 + 0.357"
    },
    "LNEW": {
     "sym": "\\ell^{(j)}",
     "idx": "\\ell^{1}",
     "num": "1.357"
    }
