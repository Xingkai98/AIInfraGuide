  },
  {
   "id": "m1",
   "title": "第 1 块：更新运行最大值 m",
   "kind": "op",
   "op": "max",
   "phase": "统计量更新",
   "formula": {
    "sym": "m^{(j)} = \\max\\left(\\slot{MOLD},\\; \\slot{BLKMAX}\\right)",
    "idx": "m^{(\\slot{J})} = \\max\\left(\\slot{MOLD},\\; \\slot{BLKMAX}\\right)",
    "num": "m^{(\\slot{J})} = \\max\\left(\\slot{MOLD},\\; \\slot{BLKMAX}\\right) = \\slot{MNEW}"
   },
   "bindings": {
    "J": {
     "sym": "j",
     "idx": "1",
     "num": "1"
    },
    "MOLD": {
     "sym": "m^{(j-1)}",
     "idx": "m^{0}",
     "num": "-\\infty"
