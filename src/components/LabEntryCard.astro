---
/**
 * Prominent "this tutorial has a replayable lab" card, rendered above the
 * article body in GuideContent.astro.
 *
 * Styling is self-contained (no Tailwind prose inheritance) and deliberately
 * loud: because lab pages carry `data-pagefind-ignore`, this card is the only
 * path by which a reader discovers the lab at all.
 */
import { getPath } from '../utils/paths';
import type { LabEntry } from '../utils/labRegistry';

interface Props {
  lab: LabEntry;
}

const { lab } = Astro.props;

const labUrl = getPath(lab.page);
// A link may carry a query string (`?step=N`) to open the player at a specific
// step; strip it before joining so the path is prefixed exactly once.
const labBaseUrl = labUrl.split('?')[0];
const links = lab.links?.length ? lab.links : [{ label: '打开实验室' }];
const isPublished = lab.published !== false;
---

<aside
  class="not-prose mb-10 overflow-hidden rounded-2xl border border-blue-200/70 bg-gradient-to-br from-blue-50 to-indigo-50/60 dark:border-blue-400/20 dark:from-blue-950/40 dark:to-indigo-950/30"
  aria-label="交互实验室"
>
  <div class="flex flex-col gap-5 p-6 sm:flex-row sm:items-start">
    <div
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#007aff] text-white shadow-sm dark:bg-[#0a84ff]"
      aria-hidden="true"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
      </svg>
    </div>

    <div class="min-w-0 flex-1">
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <span
          class="rounded-md bg-[#007aff]/10 px-2 py-0.5 font-mono text-[11px] font-semibold tracking-wide text-[#007aff] dark:bg-[#0a84ff]/15 dark:text-[#0a84ff]"
        >
          {lab.labId}
        </span>
        <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
          可交互回放
        </span>
        {!isPublished && (
          <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-700 dark:bg-amber-400/15 dark:text-amber-300">
            即将上线
          </span>
        )}
      </div>

      <h2 class="m-0 text-lg font-bold leading-snug text-gray-900 dark:text-white">
        <a href={labBaseUrl} class="hover:text-[#007aff] dark:hover:text-[#0a84ff]">{lab.title}</a>
      </h2>

      <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
        {lab.summary}
      </p>

      {lab.requires?.length ? (
        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
          前置：{lab.requires.join('、')}
        </p>
      ) : null}

      <div class="mt-4 flex flex-wrap items-center gap-2">
        {links.map((link, index) => (
          <a
            href={`${labBaseUrl}${link.search ?? ''}`}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-medium transition-colors',
              index === 0
                ? 'bg-[#007aff] text-white hover:bg-[#0066d6] dark:bg-[#0a84ff] dark:hover:bg-[#0071e3]'
                : 'border border-gray-300 text-gray-700 hover:border-gray-400 hover:text-gray-900 dark:border-white/15 dark:text-gray-300 dark:hover:border-white/30 dark:hover:text-white',
            ]}
          >
            {link.label}
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        ))}
      </div>

      {!isPublished && (
        <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
          页面尚未发布，上面的链接目前指向占位页；正式回放页会随对应 lab ticket 一起上线。
        </p>
      )}
    </div>
  </div>
</aside>
